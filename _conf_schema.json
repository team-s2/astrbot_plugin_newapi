{
  "instances": {
    "description": "new-api 实例",
    "type": "template_list",
    "hint": "添加实例并绑定可访问它的 UMO。可在对应会话中使用 /sid 获取 UMO。",
    "templates": {
      "newapi": {
        "name": "new-api 实例",
        "display_item": "name",
        "items": {
          "name": {
            "description": "实例名称",
            "type": "string",
            "hint": "用于区分输出中的不同实例。",
            "default": ""
          },
          "base_url": {
            "description": "new-api 地址",
            "type": "string",
            "hint": "例如 https://new-api.example.com，不要填写末尾的 /。",
            "default": ""
          },
          "access_token": {
            "description": "new-api Access Token",
            "type": "string",
            "password": true,
            "hint": "在 new-api 个人设置中生成的访问令牌，不是模型 API Key。",
            "default": ""
          },
          "user_id": {
            "description": "new-api 用户 ID",
            "type": "int",
            "hint": "Access Token 所属用户的数字 ID。流图需要管理员权限；令牌和节点维度需要 Root 权限。",
            "default": 1
          },
          "umos": {
            "description": "绑定的 UMO",
            "type": "list",
            "hint": "仅精确匹配完整 UMO；一个 UMO 只能绑定一个实例。",
            "default": []
          }
        }
      }
    },
    "default": []
  },
  "request_timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 20
  },
  "channel_list_limit": {
    "description": "渠道列表最多显示数量",
    "type": "int",
    "default": 30
  },
  "flow_hours": {
    "description": "流图时间范围（小时）",
    "type": "int",
    "hint": "未在 flow 命令中指定时间范围时使用，最大 720 小时（30 天）。",
    "default": 24
  },
  "flow_stages": {
    "description": "流图显示阶段",
    "type": "list",
    "options": ["user", "node", "token", "group", "model", "channel"],
    "hint": "选择需要显示的阶段；绘图始终按 user → node → token → group → model → channel 排列，至少选择两个。",
    "default": ["token", "model", "channel"]
  },
  "flow_top_n": {
    "description": "每阶段保留的 Top N",
    "type": "int",
    "hint": "提高此值可显示更多节点，但也会增加图片复杂度。",
    "default": 20
  },
  "flow_overflow": {
    "description": "Top N 以外的数据",
    "type": "string",
    "options": ["aggregate", "hide"],
    "labels": ["合并为 Other", "隐藏整条路径"],
    "default": "aggregate"
  },
  "font_path": {
    "description": "自定义字体文件路径",
    "type": "string",
    "hint": "可选。镜像没有 Noto Sans CJK 时，填写支持中文的 TTF/TTC 文件路径。",
    "default": ""
  }
}
